{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure llk-compile (Debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DLLVM_PROJECT_BUILD_DIR=${userHome}/Workspace/Projects/llvm-project/build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build llk-compile (Debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build",
        "--target", "llk-compile",
        "--parallel", "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure llk-compile (Debug)",
      "problemMatcher": ["$gcc"]
    }
  ]
}
