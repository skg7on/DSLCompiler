# Check the actual exported target and artifact, not a guessed library name.
function(llk_require_build_target target expected_type)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "${target} is missing from LLVM_PROJECT_BUILD_DIR. "
        "Build LLVM with -DLLVM_BUILD_LLVM_DYLIB=ON "
        "-DLLVM_LINK_LLVM_DYLIB=ON -DLLVM_DYLIB_COMPONENTS=all "
        "-DMLIR_LINK_MLIR_DYLIB=ON.")
  endif()
  get_target_property(_type ${target} TYPE)
  if(NOT _type STREQUAL expected_type)
    if(expected_type STREQUAL "EXECUTABLE")
      set(_description "an executable")
    else()
      set(_description "a shared library")
    endif()
    message(FATAL_ERROR "${target} must be ${_description} from "
        "LLVM_PROJECT_BUILD_DIR (found ${_type}). Rebuild LLVM with "
        "-DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON "
        "-DMLIR_LINK_MLIR_DYLIB=ON.")
  endif()

  get_target_property(_configs ${target} IMPORTED_CONFIGURATIONS)
  set(_properties)
  set(_mapping_set FALSE)
  if(NOT CMAKE_CONFIGURATION_TYPES)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _requested_config)
    get_property(_mapped TARGET ${target}
        PROPERTY MAP_IMPORTED_CONFIG_${_requested_config})
    get_property(_mapping_set TARGET ${target}
        PROPERTY MAP_IMPORTED_CONFIG_${_requested_config} SET)
    if(_mapping_set)
      if("${_mapped}" STREQUAL "")
        list(APPEND _properties IMPORTED_LOCATION)
      endif()
      foreach(_config IN LISTS _mapped)
        string(TOUPPER "${_config}" _config)
        if(_config STREQUAL "")
          list(APPEND _properties IMPORTED_LOCATION)
        else()
          list(APPEND _properties "IMPORTED_LOCATION_${_config}")
        endif()
      endforeach()
    else()
      list(APPEND _properties "IMPORTED_LOCATION_${_requested_config}")
    endif()
  endif()
  if(NOT _mapping_set)
    list(APPEND _properties IMPORTED_LOCATION)
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _config)
      list(APPEND _properties "IMPORTED_LOCATION_${_config}")
    endforeach()
  endif()

  # All exported variants must stay in this build, even if they are not built
  # yet. Canonicalize the existing ancestor to handle symlinked build paths.
  set(_all_properties IMPORTED_LOCATION ${_properties})
  foreach(_config IN LISTS _configs)
    string(TOUPPER "${_config}" _config)
    list(APPEND _all_properties "IMPORTED_LOCATION_${_config}")
  endforeach()
  foreach(_property IN LISTS _all_properties)
    get_target_property(_location ${target} ${_property})
    if(NOT _location)
      continue()
    endif()
    set(_ancestor "${_location}")
    set(_suffix "")
    while(NOT EXISTS "${_ancestor}")
      get_filename_component(_name "${_ancestor}" NAME)
      get_filename_component(_parent "${_ancestor}" DIRECTORY)
      if(_parent STREQUAL _ancestor)
        break()
      endif()
      set(_suffix "/${_name}${_suffix}")
      set(_ancestor "${_parent}")
    endwhile()
    get_filename_component(_ancestor "${_ancestor}" REALPATH)
    file(RELATIVE_PATH _relative "${LLVM_PROJECT_BUILD_DIR}" "${_ancestor}${_suffix}")
    if(_relative MATCHES "^[.][.](/|$)" OR IS_ABSOLUTE "${_relative}")
      message(FATAL_ERROR "${target} points outside LLVM_PROJECT_BUILD_DIR: ${_location}")
    endif()
  endforeach()

  # Single-config consumers follow CMake's mapping and fallback order. With
  # multi-config consumers no active configuration is known yet: only require
  # one built variant, rather than demanding unused Debug/Release artifacts.
  set(_selected_location "")
  foreach(_property IN LISTS _properties)
    get_target_property(_location ${target} ${_property})
    if(_location)
      if(NOT CMAKE_CONFIGURATION_TYPES)
        set(_selected_location "${_location}")
        break()
      elseif(EXISTS "${_location}")
        set(_selected_location "${_location}")
        break()
      elseif(NOT _selected_location)
        set(_selected_location "${_location}")
      endif()
    endif()
  endforeach()
  if(NOT _selected_location)
    message(FATAL_ERROR "${target} has no imported artifact location.")
  endif()
  if(NOT EXISTS "${_selected_location}")
    message(FATAL_ERROR "${target} has not been built: ${_selected_location}. "
        "Run cmake --build ${LLVM_PROJECT_BUILD_DIR} --target ${target}.")
  endif()
  get_filename_component(_selected_location "${_selected_location}" REALPATH)
  if(ARGC GREATER 2)
    set(${ARGV2} "${_selected_location}" PARENT_SCOPE)
  endif()
endfunction()
