{
  "schema_version": 1,
  "kind": "llk-triton-compatibility-corpus",
  "description": "The fixed, source-attributed upstream Triton compatibility corpus for the LLK Python frontend. Every executable fixture is a genuine @triton.jit kernel exported through the qualified upstream compiler, bound to concrete rank-two CPU tensors, and invoked by the LLK native frontend. Rejected fixtures declare the construct at the documented boundary; a rejection is never counted as executed compatibility.",
  "toolchain": {
    "triton_version": "3.6.0",
    "export_target": "cuda:80",
    "template_schema": 1,
    "import_protocol": 1,
    "numerical_contract": "strict-f32",
    "source_contract": "positive static rank-two compact row-major f32 tensors; zero storage offset; disjoint outputs"
  },
  "lanes": {
    "reference": {
      "required": true,
      "note": "Portable host reference execution; every executable fixture must pass here."
    },
    "selected_target": {
      "required_when_host_supports": true,
      "target": "x86-avx2",
      "requires": "x86_64 host with AVX2",
      "note": "Selected execution never falls back to reference; an unsupported host records selected_target_unavailable instead of substituting reference results."
    }
  },
