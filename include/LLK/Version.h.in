//===- Version.h.in - Generated compiler version (design §22.2) ----------===//
//
// Generated by CMake from the project version plus a `git describe` suffix.
// The plan report records this string so two compiler revisions never print
// identically. Do not edit the generated header; edit the .in template.
//
//===----------------------------------------------------------------------===//

#ifndef LLK_VERSION_H
#define LLK_VERSION_H

/// The compiler version the plan report records, e.g. `0.1.0+v0.1.0-3-gabc123`.
#define LLK_COMPILER_VERSION "@LLK_COMPILER_VERSION@"

#endif // LLK_VERSION_H
