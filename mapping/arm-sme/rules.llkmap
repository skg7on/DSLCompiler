// Arm SME mapping rules.
//
// The same typed rule families as arm-sve, under the SME prefix. Vector work
// uses the shared 512-bit vector engine; contraction is the one difference --
// it requires the `matrix_engine` capability (`za` in machines/arm-sme-v2.yaml)
// and names the `sme_mma_za` emitter. Contraction cost is the modeled lower
// bound seed 8; it is not a claim that SME is universally faster, and
// complete-plan analysis decides ranking.
//
// Every vector rule is typed on the ports it reads, and each layout requirement
// names one port, so a mixed-dtype program solves each operand against its own
// element type. Layout ids refer to layouts.llkmap.

//===----------------------------------------------------------------------===//
// Elementwise add and multiply
//===----------------------------------------------------------------------===//

rule sme.vector_add_f32 v1 {
  match micro.vector(op = "add", input[0].element_type = f32,
                     input[1].element_type = f32,
                     output[0].element_type = f32);
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies sme.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "sme.vector.add.f32";
  emit "sme_vector_add";
  cost 4;
}

rule sme.vector_add_bf16 v1 {
  match micro.vector(op = "add", input[0].element_type = bf16,
                     input[1].element_type = bf16,
                     output[0].element_type = bf16);
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies sme.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "sme.vector.add.bf16";
  emit "sme_vector_add";
  cost 4;
}

