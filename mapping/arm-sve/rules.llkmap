// Arm SVE mapping rules.
//
// A rule names one Micro operation pattern and the bundle that implements it.
// `bundle` and `emit` are opaque: this file names them, the SVE target package
// gives them meaning. Layout ids refer to layouts.llkmap and are never
// redefined here. Capability kinds must be ones machines/arm-sve-v2.yaml
// declares -- `verifyMappingTarget` rejects the file otherwise.
//
// Every vector rule is typed on the ports it reads. The profile supports f32,
// bf16 and i8 elementwise work, bf16<->f32 conversion, and f32 SiLU and
// reduction; a dtype outside that table matches no rule rather than binding to
// an implementation that does not exist. Layout requirements name one port
// each, so a mixed-dtype program solves each operand against its own element
// type instead of a graph-wide first value.
//
// There is no rule parameter for the vector width: the layout requirement is
// what carries it, per port. A rule parameter that duplicated it would add an
// assignment the solver does not need and could pin a mixed-dtype operand to
// the wrong width.

//===----------------------------------------------------------------------===//
// Elementwise add and multiply
//===----------------------------------------------------------------------===//

rule sve.vector_add_f32 v1 {
  match micro.vector(op = "add", input[0].element_type = f32,
                     input[1].element_type = f32,
                     output[0].element_type = f32);
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies sve.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "sve.vector.add.f32";
  emit "sve_vector_add";
  cost 4;
}

rule sve.vector_add_bf16 v1 {
  match micro.vector(op = "add", input[0].element_type = bf16,
                     input[1].element_type = bf16,
                     output[0].element_type = bf16);
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies sve.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "sve.vector.add.bf16";
  emit "sve_vector_add";
  cost 4;
}

