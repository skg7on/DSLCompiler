// AVX2 mapping rules.
//
// A rule names one Micro operation pattern and the bundle that implements it.
// `bundle` and `emit` are opaque: this file names them, the AVX2 plugin gives
// them meaning. Layout ids refer to layouts.llkmap and are never redefined
// here. Capability kinds must be ones machines/x86-avx2-v2.yaml declares --
// `verifyMappingTarget` rejects the file otherwise.
//
// Attribute predicates read the operation's attributes by name: `micro.vector`
// and `micro.reduce` carry `op`. A port predicate reads a boundary value
// instead: `input[0].element_type = bf16` checks the first operand's element
// type (`micro.mma`'s lhs), not an attribute.

rule avx2.vector_add v1 {
  match micro.vector(op = "add");
  param VW in [4..8];
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies avx2.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "avx2.vector.add.f32";
  emit "avx2_vector_add";
  cost 4;
}

// `micro.vector` is one op with an `op` attribute, so each variant the lowering
// emits is matched on that attribute. `--llk-to-micro` emits exactly three --
// `convert` (the accumulator narrowing), `silu` (the gate activation), and
// `mul` (the gating multiply) -- so three rules cover them. There is
// deliberately no catch-all: an op value with no rule stays `no_matching_rule`
// rather than being bound to an implementation that does not exist.
//
// Each requires its f32 operand (the accumulator tile) in avx2.blocked_2d.
// The requirement is solved against that operand's own element type -- f32,
// lanes 8 -- not the graph's first value, so it holds even inside a bf16 tile
// program where the accumulator is the only f32 value.

rule avx2.vector_convert v1 {
  match micro.vector(op = "convert");
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies avx2.blocked_2d;
  input "operand0";
  output "result";
  bundle "avx2.vector.convert.f32";
  emit "avx2_vector_convert";
  cost 2;
}

rule avx2.vector_silu v1 {
  match micro.vector(op = "silu");
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies avx2.blocked_2d;
  input "operand0";
  output "result";
  bundle "avx2.vector.silu.f32";
  emit "avx2_vector_silu";
  cost 4;
}

rule avx2.vector_mul v1 {
  match micro.vector(op = "mul");
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies avx2.blocked_2d;
  input "operand0";
  input "operand1";
  output "result";
  bundle "avx2.vector.mul.f32";
  emit "avx2_vector_mul";
  cost 4;
}

rule avx2.mma_bf16 v1 {
  match micro.mma(input[0].element_type = bf16);
  param VW in [4..8];
  require VW == machine.compute("vector_engine").lanes("f32");
  require executor kind worker;
  require compute kind matrix_engine;
  require layout lhs satisfies avx2.row_major;
  input "lhs";
  input "rhs";
  input "acc";
  output "result";
  bundle "avx2.mma.bf16" { VW = VW };
  emit "avx2_mma";
  cost 16;
}

rule avx2.mma_f32 v1 {
  match micro.mma(input[0].element_type = f32);
  param VW in [4..8];
  require VW == machine.compute("vector_engine").lanes("f32");
  require executor kind worker;
  require compute kind matrix_engine;
  require layout lhs satisfies avx2.row_major;
  input "lhs";
  input "rhs";
  input "acc";
  output "result";
  bundle "avx2.mma.f32" { VW = VW };
  emit "avx2_mma";
  cost 16;
}

rule avx2.reduce_sum_f32 v1 {
  match micro.reduce(op = "sum");
  param VW in [4..8];
  require VW == machine.compute("vector_engine").lanes("f32");
  require executor kind worker;
  require compute kind vector_engine;
  input "operand0";
  output "result";
  bundle "avx2.reduce.sum.f32" { VW = VW };
  emit "avx2_reduce";
  cost 3;
}

// `micro.async_copy` is the one shipped operation whose boundary values are
// plain `tensor`s: it moves into a low-level memory rather than operating on a
// tile that already states one, so its endpoint occurrences carry no explicit
// memory kind. The rule therefore has to *name* the ports it governs -- source
// DRAM to destination SRAM, the profile's load path -- or a strict binding has
// no fact saying where the copied value lives. Every other shipped rule leaves
// the memory to the tile its operands and results already carry, which is why
// none of them hard-codes `sram`/`acc`: the same `micro.vector "add"` runs in
// SRAM in the vector-add program and in `acc` in the tiled matmul, and a rule
// that named one kind would make the other unplaceable.
rule avx2.async_copy v1 {
  match micro.async_copy();
  require executor kind worker;
  require memory input "source" kind dram;
  require memory output "result" kind sram;
  input "source";
  output "result";
  bundle "avx2.copy";
  emit "avx2_copy";
  cost 2;
}

rule avx2.tile_async_copy v1 {
  match micro.tile_async_copy();
  require executor kind worker;
  input "source";
  output "result";
  bundle "avx2.tile.copy";
  emit "avx2_tile_copy";
  cost 2;
}

rule avx2.tile_store v1 {
  match micro.tile_store();
  require executor kind worker;
  input "source";
  bundle "avx2.tile.store";
  emit "avx2_tile_store";
  cost 2;
}

// The SwiGLU epilogue's shape, implemented as one unit: a convert feeding a
// SiLU feeding the gating multiply. A graph rule matches a *subgraph*, so the
// three operations are placed and emitted together -- the intermediate tiles
// never cross a rule boundary, which is what makes the fused implementation a
// different program from three separate ones rather than a relabelling of them.
rule avx2.fused_convert_silu_mul v1 {
  match graph {
    node cv: micro.vector(op = "convert");
    node act: micro.vector(op = "silu");
    node gate: micro.vector(op = "mul");
    edge cv.result -> act.operand0;
    edge act.result -> gate.operand0;
  }
  param VW in [4..8];
  require VW == machine.compute("vector_engine").lanes(element_type);
  require executor kind worker;
  require compute kind vector_engine;
  require layout cv.operand0 satisfies avx2.blocked_2d;
  require layout gate.operand1 satisfies avx2.blocked_2d;
  require layout gate.result satisfies avx2.blocked_2d;
  input "cv.operand0";
  input "gate.operand1";
  output "gate.result";
  bundle "avx2.fused.convert_silu_mul" { VW = VW };
  emit "avx2_fused_convert_silu_mul";
  cost 3;
}
