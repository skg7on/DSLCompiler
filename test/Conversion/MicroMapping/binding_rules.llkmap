// Mapping rules for the binding-driven mapping fixture.
//
// Two rules, one per workload node of the fixture kernel: a staged copy
// (`micro.async_copy`, layout-agnostic) and the vector add. The add rule
// declares parameter `VW` and a layout requirement on `blocked` -- the id the
// fixture's search space binds -- so the fixture exercises both binding axes at
// once: the pinned rule parameter (phase-4 T2) and the bound layout (T3). The
// layout id is `blocked` because the search space cannot spell anything else
// (see binding_layouts.llkmap).

rule binding.vector_add v1 {
  match micro.vector(op = "add");
  param VW in [4..8];
  require VW == machine.compute("vector_engine").lanes(element_type);
  require executor kind worker;
  require compute kind vector_engine;
  require layout operand0 satisfies blocked;
  input "operand0";
  input "operand1";
  output "result";
  bundle "binding.vector.add.f32";
  emit "binding_vector_add";
  cost 4;
}

// Layout-agnostic: no `require layout`, so a bound layout neither matches nor
// contradicts it (ruling S7). Leaving one rule in the fixture without a layout
// obligation is what pins that behaviour: if the layout axis vetoed it, no plan
// would exist even for the matching candidate.
rule binding.async_copy v1 {
  match micro.async_copy();
  require executor kind worker;
  bundle "binding.copy";
  emit "binding_copy";
  cost 2;
}
